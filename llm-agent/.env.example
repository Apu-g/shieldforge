# Supabase project (server-side only; never expose the service role key to the browser)
SUPABASE_URL=https://iczdkmkhryaepcdmviyr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# LLM providers
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_SITE_URL=http://localhost:3002
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Third fallback
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Shared secret for /api/explain, /api/poll and /api/training/{simulate,decay}.
# Leave empty only for local demo. The click tracker stays public on purpose.
AGENT_SECRET=

# Used by scripts/poll.mjs
AGENT_URL=http://localhost:3002
POLL_INTERVAL_MS=7000
