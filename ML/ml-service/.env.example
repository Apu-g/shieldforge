# Service configuration (all optional).

# Path to the trained artifact.
MODEL_PATH=artifacts/model.joblib
MODEL_VERSION=shieldforge-ml-1.0.0

# Decision bands: below LOG_BELOW -> log, up to ALERT_BELOW -> alert, above -> strong action.
LOG_BELOW=0.60
ALERT_BELOW=0.90

# CORS. Comma-separated list, or * for the hackathon demo.
CORS_ORIGINS=*

# Logging.
LOG_LEVEL=INFO
