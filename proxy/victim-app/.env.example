# Mount point when the proxy forwards /t/victim-shop to this app.
# Leave empty when running in host-routing mode (victim.local).
NEXT_PUBLIC_BASE_PATH=/t/victim-shop

# true  = deliberately vulnerable demo (weak cookie, raw HTML rendering)
# false = hardened demo (HttpOnly cookie, escaped output)
VICTIM_VULNERABLE=true

# Optional. Defaults to ./.data locally and /tmp on Vercel.
# VICTIM_DATA_FILE=/tmp/shieldforge-victim/messages.json
