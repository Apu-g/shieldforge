# ---------------------------------------------------------------------------
# ShieldForge dashboard
#
# If these Supabase values are present (URL + service role key), the dashboard
# reads and writes your Supabase project and the browser subscribes to
# Realtime. If they are absent the app boots into a fully functional local
# DEMO MODE with in-memory seed data, so it can be demoed/tested standalone.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: public base URL of Part 1's proxy, used only to render a copyable
# proxy link on the Origins page. Leave blank if the proxy is not deployed.
NEXT_PUBLIC_PROXY_BASE_URL=
